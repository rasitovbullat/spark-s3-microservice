# ===== Application =====
APP_ENV=development
PORT=8080
LOG_LEVEL=debug

# ===== Yandex S3 =====
YANDEX_ENDPOINT=storage.yandexcloud.net
YANDEX_BUCKET=spark-messenger-media
YANDEX_ACCESS_KEY_ID=your-access-key-id
YANDEX_SECRET_ACCESS_KEY=your-secret-access-key
YANDEX_S3_REGION=ru-central1

# ===== Firebase =====
# Path to the Firebase service account JSON file
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# ===== Presigned URLs =====
# Expiry times in seconds
PRESIGNED_URL_EXPIRY_UPLOAD=300
PRESIGNED_URL_EXPIRY_DOWNLOAD=900

# ===== CORS =====
# Comma-separated list of allowed origins
# Use * for development, specify exact origins for production
CORS_ALLOWED_ORIGINS=https://spark-2ea6a.web.app,http://localhost:3000